#include <stdio.h>
#include <stdlib.h>

// Helper function to find the maximum of two integers
int max(int a, int b) {
    return (a > b) ? a : b;
}

int main() {
    int n, w_capacity;

    // Read the number of items
    if (scanf("%d", &n) != 1) return 0;

    // Allocate memory for values and weights
    int *values = (int *)malloc(n * sizeof(int));
    int *weights = (int *)malloc(n * sizeof(int));

    // Read values of the items
    for (int i = 0; i < n; i++) {
        scanf("%d", &values[i]);
    }

    // Read weights of the items
    for (int i = 0; i < n; i++) {
        scanf("%d", &weights[i]);
    }

    // Read the maximum knapsack capacity
    scanf("%d", &w_capacity);

    // Create a 1D DP array initialized to 0
    int *dp = (int *)calloc(w_capacity + 1, sizeof(int));

    // Bottom-up DP to compute maximum value
    for (int i = 0; i < n; i++) {
        for (int w = w_capacity; w >= weights[i]; w--) {
            dp[w] = max(dp[w], dp[w - weights[i]] + values[i]);
        }
    }

    // Print the maximum total value obtained
    printf("%d\n", dp[w_capacity]);

    // Free dynamically allocated memory
    free(values);
    free(weights);
    free(dp);

    return 0;
}
