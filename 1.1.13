#include <stdio.h>
#include <stdlib.h>

#define INF 1e9

int n;
int dist[20][20];
int memo[20][1 << 20];

// Bitmask DP function to find the minimum TSP tour cost
int tsp(int u, int mask) {
    // If all cities have been visited, return the cost to go back to the starting city (0)
    if (mask == (1 << n) - 1) {
        if (dist[u][0] != -1) return dist[u][0];
        return INF;
    }
    
    // Return cached result if already calculated
    if (memo[u][mask] != -1) return memo[u][mask];
    
    int ans = INF;
    for (int v = 0; v < n; v++) {
        // If city v hasn't been visited and a direct road exists
        if (!(mask & (1 << v)) && dist[u][v] != -1) {
            int new_cost = dist[u][v] + tsp(v, mask | (1 << v));
            if (new_cost < ans) {
                ans = new_cost;
            }
        }
    }
    return memo[u][mask] = ans;
}

int main() {
    // Read the number of cities
    if (scanf("%d", &n) != 1) return 0;
    
    // Read the cost matrix
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &dist[i][j]);
        }
    }
    
    // Initialize the memoization array with -1
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < (1 << n); j++) {
            memo[i][j] = -1;
        }
    }
    
    // Start the tour from city 0, with only city 0 marked as visited (mask = 1)
    int result = tsp(0, 1);
    
    // Print the optimal cost
    printf("%d\n", result);
    
    return 0;
}
